load("@pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary")

py_binary(
    name = "build_deck",
    srcs = ["build_deck.py"],
    deps = [
        requirement("lxml"),
        requirement("python-pptx"),
    ],
)

genrule(
    name = "deck",
    srcs = ["//slides/template:EngFlow_Dark_Template.pptx"],
    outs = ["AdvancedBazel_TestingAndValidation.pptx"],
    cmd = """
$(execpath :build_deck) \\
    --template $(execpath //slides/template:EngFlow_Dark_Template.pptx) \\
    --output $@
""",
    tools = [":build_deck"],
)
